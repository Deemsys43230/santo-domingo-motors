# LiveKit server credentials (get these from https://cloud.livekit.io or your self-hosted server)
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key

# Gemini Realtime model + voice. Model ids for Gemini's Live/Realtime API
# change fairly often -- check LiveKit's Google plugin docs and Google AI
# Studio for the current id before running the POC.
GEMINI_REALTIME_MODEL=gemini-2.0-flash-live-001
GEMINI_VOICE=Puck
GEMINI_TEMPERATURE=0.7

DEALERSHIP_NAME=Santo Domingo Motors
